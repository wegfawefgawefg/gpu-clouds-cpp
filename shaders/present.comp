#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform readonly image2D sourceImage;
layout(rgba8, binding = 1) uniform writeonly image2D outputImage;

layout(std140, binding = 2) uniform FrameParams
{
    vec4 cameraPosition;
    vec4 cameraForward;
    vec4 cameraRight;
    vec4 cameraUp;
    vec4 renderInfo;
    vec4 timeInfo;
    vec4 cloudShape;
    vec4 cloudMarch;
    vec4 lightDirection;
    vec4 sunColorIntensity;
    vec4 skyTopColor;
    vec4 skyHorizonColor;
    vec4 wind;
    vec4 postInfo;
    vec4 sunScreen;
    vec4 postExtra;
    vec4 overlayInfo;
} params;

layout(std430, binding = 3) readonly buffer OverlayBuffer
{
    uint overlayPixels[];
};

vec4 sampleSource(vec2 uv)
{
    ivec2 renderSize = ivec2(params.renderInfo.xy);
    vec2 pixel = clamp(uv * vec2(renderSize) - 0.5, vec2(0.0), vec2(renderSize) - 1.0);
    ivec2 a = ivec2(floor(pixel));
    ivec2 b = min(a + ivec2(1), renderSize - 1);
    vec2 f = fract(pixel);

    vec4 c00 = imageLoad(sourceImage, a);
    vec4 c10 = imageLoad(sourceImage, ivec2(b.x, a.y));
    vec4 c01 = imageLoad(sourceImage, ivec2(a.x, b.y));
    vec4 c11 = imageLoad(sourceImage, b);

    vec4 cx0 = mix(c00, c10, f.x);
    vec4 cx1 = mix(c01, c11, f.x);
    return mix(cx0, cx1, f.y);
}

vec3 sampleSourceColor(vec2 uv)
{
    return sampleSource(uv).rgb;
}

float sampleTransmittance(vec2 uv)
{
    return sampleSource(uv).a;
}

vec4 unpackOverlayPixel(uint packed)
{
    return vec4(
        float(packed & 0xFFu),
        float((packed >> 8u) & 0xFFu),
        float((packed >> 16u) & 0xFFu),
        float((packed >> 24u) & 0xFFu)
    ) / 255.0;
}

float luminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 sampleBloom(vec2 uv)
{
    float radius = max(params.postExtra.y, 0.5);
    vec2 texel = radius / vec2(max(params.renderInfo.xy, vec2(1.0)));
    vec2 offsets[12] = vec2[](
        vec2(-1.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, -1.0),
        vec2(0.0, 1.0),
        vec2(-1.0, -1.0),
        vec2(1.0, -1.0),
        vec2(-1.0, 1.0),
        vec2(1.0, 1.0),
        vec2(-2.0, 0.0),
        vec2(2.0, 0.0),
        vec2(0.0, -2.0),
        vec2(0.0, 2.0)
    );

    vec3 bloom = vec3(0.0);
    for (int index = 0; index < 12; ++index)
    {
        vec3 sampleColor = sampleSourceColor(clamp(uv + offsets[index] * texel, vec2(0.0), vec2(1.0)));
        float bright = max(luminance(sampleColor) - params.postInfo.w, 0.0);
        bloom += sampleColor * bright;
    }

    return bloom / 12.0;
}

vec3 sampleGodRays(vec2 uv)
{
    if (params.sunScreen.z < 0.5 || params.sunScreen.w <= 0.001)
    {
        return vec3(0.0);
    }

    vec2 sunUv = params.sunScreen.xy;
    vec2 delta = (sunUv - uv) / 40.0;
    vec2 coord = uv;
    float decay = 1.0;
    vec3 rays = vec3(0.0);
    float previousMask = smoothstep(0.82, 0.995, sampleTransmittance(clamp(uv, vec2(0.0), vec2(1.0))));

    for (int index = 0; index < 40; ++index)
    {
        coord += delta;
        vec2 clampedCoord = clamp(coord, vec2(-0.25), vec2(1.25));
        float transmittance = sampleTransmittance(clamp(clampedCoord, vec2(0.0), vec2(1.0)));
        float skyMask = smoothstep(0.82, 0.995, transmittance);
        float edgeMask = max(skyMask - previousMask, 0.0);
        float shaftMask = skyMask * 0.18 + edgeMask * 4.8;
        rays += params.sunColorIntensity.rgb * params.sunColorIntensity.w * shaftMask * decay;
        previousMask = skyMask;
        decay *= params.postExtra.x;
    }

    float localClear = smoothstep(0.86, 0.995, sampleTransmittance(uv));
    float sunDistance = length(uv - sunUv);
    float radialFade = 1.0 - smoothstep(1.8, 3.4, sunDistance);
    float sunDisc = pow(max(1.0 - sunDistance * 3.0, 0.0), 10.0);
    float belowSun = smoothstep(sunUv.y - 0.02, sunUv.y + 0.18, uv.y);
    float lowerAtmosphere = pow(smoothstep(max(sunUv.y, 0.08), 1.05, uv.y), 1.45);
    float horizonBoost = smoothstep(0.32, 0.92, uv.y);
    vec3 sunBoost =
        params.sunColorIntensity.rgb * params.sunColorIntensity.w *
        (0.35 * sunDisc + 0.10 * radialFade);
    return (rays / 14.0 + sunBoost) * radialFade * localClear * belowSun * lowerAtmosphere *
           horizonBoost;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = ivec2(params.renderInfo.zw);
    if (pixel.x >= outputSize.x || pixel.y >= outputSize.y)
    {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(outputSize);
    vec3 hdrColor = sampleSourceColor(uv) * params.postInfo.x;
    hdrColor += sampleBloom(uv) * params.postInfo.z * 2.2;
    hdrColor += sampleGodRays(uv) * params.sunScreen.w * 5.5;

    vec3 color = hdrColor / (hdrColor + vec3(1.0));
    color = pow(color, vec3(1.0 / 2.2));
    color = (color - 0.5) * params.postInfo.y + 0.5;
    color = clamp(color, vec3(0.0), vec3(1.0));

    ivec2 overlaySize = ivec2(params.overlayInfo.xy);
    ivec2 overlayOrigin = ivec2(params.overlayInfo.zw);
    ivec2 overlayPixel = pixel - overlayOrigin;
    if (overlayPixel.x >= 0 && overlayPixel.y >= 0 &&
        overlayPixel.x < overlaySize.x && overlayPixel.y < overlaySize.y)
    {
        int overlayIndex = overlayPixel.y * 1024 + overlayPixel.x;
        vec4 overlayColor = unpackOverlayPixel(overlayPixels[overlayIndex]);
        color = mix(color, overlayColor.rgb, overlayColor.a);
    }

    imageStore(outputImage, pixel, vec4(color, 1.0));
}
